datasource db {
  provider = "postgresql"
  }

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())

  preferences   UserPreferences?
  channelScores ChannelScore[]
  events        InteractionEvent[]
}

model UserPreferences {
  userId             String  @id
  minDurationMinutes Int     @default(10)
  focusModeEnabled   Boolean @default(true)
  blockedChannelIds  String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChannelScore {
  userId     String
  channelId  String
  score      Int      @default(0)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
}

model InteractionEvent {
  id              String   @id @default(uuid())
  userId          String
  videoId         String
  channelId       String
  eventType       String
  watchPercentage Int?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
